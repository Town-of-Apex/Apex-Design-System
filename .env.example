# =============================================================================
# APEX APP — ENVIRONMENT CONFIGURATION
# Copy to .env and adjust per deployment mode (see POSTGRES_HOST notes below).
# =============================================================================

# App routing (empty for local dev, /your-app-slug for production behind Traefik)
BASE_PATH=
PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL connection (component variables — preferred)
# config.py builds DATABASE_URL from these unless DATABASE_URL is set directly.
# -----------------------------------------------------------------------------

# Host depends on how you run the app:
#   run_dev.ps1 / run_dev.sh (host backend)  → 127.0.0.1 (or localhost)
#   docker compose -f docker-compose.dev.yml → apex-dev-db  (in-container hostname)
#   docker compose up (production)           → postgres_db  (centralized production DB)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=password

# Optional: override the built connection string entirely.
# Use for SQLite-only local work:
# DATABASE_URL=sqlite:///./data/app.db

# -----------------------------------------------------------------------------
# Database behavior
# -----------------------------------------------------------------------------
# Allow falling back to a local SQLite file when PostgreSQL is unreachable.
# Recommended: true for local dev, false for production.
ALLOW_SQLITE_FALLBACK=true

# Location of the SQLite fallback database file.
FALLBACK_DATABASE_URL=sqlite:///./data/app.db

# Create ORM tables on startup (create_all). Recommended: true for dev, false for production.
# When unset, defaults to the value of DEV_MODE.
# AUTO_CREATE_TABLES=true

# Set automatically by compose files; override here only for bare-metal dev.
DEV_MODE=true
RUN_MIGRATIONS=true
AUTO_MIGRATE_DEV=true

# -----------------------------------------------------------------------------
# Authentication (dev-mode JWT — replace with Entra in production)
# -----------------------------------------------------------------------------
AUTH_ENABLED=true
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480
SEED_DEV_ADMIN=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin123

# =============================================================================
# PRODUCTION CHECKLIST (centralized postgres_db container)
# =============================================================================
# 1. Create database and user in the shared Postgres container (via pgAdmin or psql):
#      CREATE DATABASE my_app_db;
#      CREATE ROLE my_app_user WITH LOGIN PASSWORD 'strong-password';
#      GRANT ALL PRIVILEGES ON DATABASE my_app_db TO my_app_user;
# 2. Update POSTGRES_* values above (or set DATABASE_URL directly).
# 3. Set POSTGRES_HOST=postgres_db
# 4. Set DEV_MODE=false, ALLOW_SQLITE_FALLBACK=false, RUN_MIGRATIONS=true, AUTO_MIGRATE_DEV=false
# 5. Run `alembic upgrade head` before first deploy (or enable RUN_MIGRATIONS on startup)
# 6. Deploy with: docker compose up -d --build
